rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null && request.auth.uid == "yyxiD75owvSIKHPWZixu7aOouMX2";
    }

    // The current start code. Only the teacher can see or change it.
    match /config/startCode {
      allow read, write: if isTeacher();
    }

    // A laptop "unlocks" by sending the teacher's code. Only allowed if the code is right.
    match /unlocked/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.code == get(/databases/$(database)/documents/config/startCode).data.code;
      allow read: if isTeacher() || (request.auth != null && request.auth.uid == uid);
      allow delete: if isTeacher();
    }

    // The class lists. Only the teacher can change them, and only unlocked laptops can read them,
    // so nobody sees student names without the teacher's code.
    match /config/roster {
      allow read: if isTeacher()
        || (request.auth != null && exists(/databases/$(database)/documents/unlocked/$(request.auth.uid)));
      allow write: if isTeacher();
    }

    // A student's laptop creates a session by sending the code the teacher typed.
    // It is only allowed if that code matches the current start code, which students can never read.
    match /sessions/{sessionId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.studentName is string
        && request.resource.data.className is string
        && request.resource.data.code == get(/databases/$(database)/documents/config/startCode).data.code;
      allow read, delete: if isTeacher();
    }

    // Test results. A laptop can only save results for the student its own session was opened for.
    match /results/{resultId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.studentName == request.resource.data.studentName
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.className == request.resource.data.className;
      allow read, delete: if isTeacher();
    }
  }
}
